/target
**/*.DS_Store

# The workspace lock is committed so CI and demos use the audited dependency graph.
# The standalone fuzz workspace maintains its own lock.
crates/yororen-ui-xml/fuzz/Cargo.lock
crates/yororen-ui-demos/counter/Cargo.lock

# Demo targets (legacy and workspace paths)
demo/**/target
crates/yororen-ui-demos/*/target

# cargo-fuzz build outputs
crates/*/fuzz/target/

# cargo-fuzz generated corpus / crash artifacts
crates/*/fuzz/corpus/
crates/*/fuzz/artifacts/

# Local cargo-fuzz installation (cargo install --root .cargo)
.cargo/bin/
.cargo/registry/
.cargo/git/

yororen-ui.wiki

/tmp
